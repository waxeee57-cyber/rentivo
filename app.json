{
  "expo": {
    "name": "Rentivo",
    "slug": "rentivo",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rentivo",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.domrol.rentivo",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rentivo uses your location to show nearby rentals.",
        "NSCameraUsageDescription": "Rentivo needs camera access for vehicle inspection photos.",
        "NSPhotoLibraryUsageDescription": "Rentivo needs photo library access for vehicle inspection.",
        "NSPhotoLibraryAddUsageDescription": "Rentivo needs access to save photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.domrol.rentivo",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      ["expo-router", { "origin": "https://rentivo.domrol.com" }],
      "expo-location",
      "expo-camera",
      "expo-media-library",
      [
        "expo-notifications",
        {
          "color": "#E8A44A"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.domrol.rentivo",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
