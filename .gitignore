# Learn more: https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Next.js (stray artifacts should not appear in this Expo repo)
.next/
out/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
build-log.txt

# macOS / Windows
.DS_Store
*.pem
Thumbs.db

# Local env files
.env
.env.*
.env*.local
*.stash-backup
# The .env.* rule above would also hide the committed example; this negation keeps it.
!.env.example

# Google Play service account key
google-play-service-account.json

# TypeScript
*.tsbuildinfo

# Generated native folders
/ios
/android

# Binary / Python scratch (hygiene audit)
*.exe
__pycache__/
*.pyc

# Build output
build/
.vercel/
coverage/

# Release signing
android/keystore.properties
android/app/rentivo-release.keystore
