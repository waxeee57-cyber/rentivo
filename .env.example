# SUPABASE
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
# KEY MIGRATION (legacy -> new). A kliens az ÚJ publishable kulcsot preferálja,
# és visszaesik a legacy anon-ra, amíg mindkettő él Supabase-en. Beállítás után
# a legacy anon kikapcsolható a Supabase Dashboardon.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # ÚJ (client-safe)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key      # LEGACY (fallback)
# SOHA ne tedd be a secret/service_role kulcsot client-side kódba.
# Edge Function secrets (server-only). FIGYELEM: a Supabase a `SUPABASE_` prefixet
# fenntartja → custom secretet ezzel a prefixszel nem lehet beállítani. Ezért az
# ÚJ kulcsokat NEM-fenntartott néven állítsd be; a kód sorrendje:
#   SB_SECRET_KEY=sb_secret_...        -> ÚJ secret (ezt állítsd be Edge secretként)
#     fallback: SUPABASE_SECRET_KEY (ha a platform auto-injektálja) -> SUPABASE_SERVICE_ROLE_KEY (legacy)
#   SB_PUBLISHABLE_KEY=sb_publishable_...  -> drip-email anon-helyettesítő (Edge secret)
#     fallback: SUPABASE_PUBLISHABLE_KEY -> SUPABASE_ANON_KEY (legacy)

# STRIPE
# Érvényes formátum: pk_test_... (fejlesztés/TestFlight) vagy pk_live_... (production)
# Valódi kulcsot CSAK EAS Secrets / dashboard tárol — soha ne ide
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_key
# STRIPE_SECRET_KEY csak server-side (Supabase Edge Function env var)

# MONITORING (Sentry)
# Üresen hagyva a Sentry init csendben kihagyódik — az app DSN nélkül is fut
EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN csak build-time source map upload-hoz (EAS Secrets)
SENTRY_AUTH_TOKEN=

# APP CONFIG
EXPO_PUBLIC_USE_MOCK=true

# --- kiegészítés 2026-07-18 (baseline audit): a kódban ténylegesen olvasott,
# --- de innen addig hiányzó kulcsok. Minden érték placeholder.

# APP CONFIG (folyt.) — mind: constants/config.ts (Config objektum)
# API base URL. Kód default-ja: https://api.rentivo.domrol.com
EXPO_PUBLIC_API_URL=
# Megjelenített app-név. Kód default-ja: Rentivo (EAS preview profil: "Rentivo Preview")
EXPO_PUBLIC_APP_NAME=
# Platform jutalék arány, 0-1 közti tizedes. Kód default-ja: 0.10
EXPO_PUBLIC_PLATFORM_CUT=0.10
# Google Maps kapcsoló. FIGYELEM: csak akkor állítsd true-ra, ha a natív
# com.google.android.geo.API_KEY is benne van a buildben (app.json →
# android.config.googleMaps.apiKey), különben a <MapView> mount-kor hard crashel.
EXPO_PUBLIC_MAPS_ENABLED=false
# Booking.com affiliate ID — lib/api/unifiedSearch.ts. Forrás: Booking.com affiliate partner fiók
EXPO_PUBLIC_BOOKING_AFFILIATE_ID=

# BOOKING.COM (server-only titok)
# lib/api/unifiedSearch.ts olvassa EXPO_PUBLIC_ prefix NÉLKÜL, kliensoldali kódban →
# az Expo bundle-ben mindig üres. Vagy prefix kell, vagy Edge Functionbe kell mozgatni.
# Forrás: Booking.com Affiliate/Demand API partner fiók
BOOKING_API_TOKEN=

# --- SUPABASE EDGE FUNCTION SECRETS (server-only, `supabase secrets set`) ---
# Ezeket NEM az app bundle olvassa, hanem a supabase/functions/* Deno kód.
# Soha ne kerüljenek EXPO_PUBLIC_ prefix mögé.

# Stripe webhook aláírás-ellenőrzés — supabase/functions/stripe-webhook
# Forrás: Stripe Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform jutalék az Edge oldalon — create-booking, create-payment-intent. Default: 0.10
PLATFORM_CUT=0.10
# Deep link / visszatérési URL a Stripe account linkhez — create-stripe-account-link
# Kód default-ja: rentivo://app
APP_URL=
# Admin push broadcast védelme — broadcast-push. Saját generált random titok
ADMIN_BROADCAST_SECRET=
# Edge→Edge belső hívások védelme — drip-email, operator-webhook-dispatch, send-email
# Saját generált random titok
INTERNAL_FUNCTION_SECRET=
# Claude API — damage-detector, pricing-suggestions, rental-assistant, translate-message
# Forrás: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Tranzakciós email — send-email. Forrás: resend.com → API Keys
RESEND_API_KEY=re_...
# Járatkövetés — flight-tracker. Forrás: aviationstack.com → dashboard
AVIATIONSTACK_API_KEY=

# DIDIT KYC (MÁR ÉLES A KÓDBAN — lásd lentebb a "JÖVŐBENI KAPUK" ellentmondást)
# supabase/functions/didit-create-session + didit-webhook. Forrás: Didit partner dashboard
DIDIT_CLIENT_ID=
DIDIT_CLIENT_SECRET=
DIDIT_WEBHOOK_SECRET=

# TESZT SCRIPTEK (lokális, opcionális)
# Kényszerített Stripe Connect account a scripts/itest-payments.ts-hez. Forrás: Stripe Dashboard → Connect
ITEST_CONNECT_ACCOUNT_ID=

# JÖVŐBENI KAPUK:
# FIGYELEM: a DIDIT_* kulcsok már NEM jövőbeniek — a kódban élnek, lásd fentebb.
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_...
# HEYGEN_API_KEY=...
# SMARTLEAD_API_KEY=...
# POSTHOG_API_KEY=phc_...
# BOOKING_COM_AFFILIATE_ID=...
# NYLAS_CLIENT_ID=...
# SENTRY_DSN=https://...@sentry.io/...
# TRIGGER_DEV_API_KEY=...
