{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "description": "TypeScript check fájl írás után",
        "hooks": [
          {
            "type": "command",
            "command": "cd C:\\projects\\Rentivo && npx tsc --noEmit --noErrorTruncation 2>&1 | tail -5",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "Bash",
        "description": "RLS check supabase push után",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'supabase db push detected — run rls-audit skill to verify policies'",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "description": "Veszélyes parancsok blokkolása",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"$cmd = $input | ConvertFrom-Json | Select-Object -ExpandProperty tool_input | ConvertFrom-Json | Select-Object -ExpandProperty command; if ($cmd -match 'rm -rf|Remove-Item.*-Recurse.*-Force.*\\.(env|git)') { exit 2 } else { exit 0 }\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "description": "Session vége — emlékeztető",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Session ending. Remember: npx tsc --noEmit before final commit.'",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
