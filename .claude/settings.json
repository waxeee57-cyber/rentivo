{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "description": "TypeScript check fájl írás után",
        "hooks": [
          {
            "type": "command",
            "command": "cd C:\\projects\\rentivo; npx tsc --noEmit --noErrorTruncation | Select-Object -Last 5",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "Bash",
        "description": "RLS check supabase push után",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'supabase db push detected — run rls-audit skill to verify policies'",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "description": "Veszélyes parancsok blokkolása",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\projects\\rentivo\\.claude\\hooks\\block-dangerous.ps1\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "description": "Session vége — emlékeztető",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Session ending. Remember: npx tsc --noEmit before final commit.'",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
